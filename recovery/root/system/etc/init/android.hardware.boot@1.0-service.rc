# Register the recovery HAL before the A/B installer mounts the ROM's /vendor.
# Otherwise lazy startup can load the ROM implementation instead of ours.
on property:hwservicemanager.ready=true
    start boot-hal-1-0

service boot-hal-1-0 /system/bin/android.hardware.boot@1.0-service
    interface android.hardware.boot@1.0::IBootControl default
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib
    disabled
    seclabel u:r:recovery:s0
